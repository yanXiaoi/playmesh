{
  "openapi": "3.1.0",
  "info": {
    "title": "Playmesh Developer Channel",
    "version": "1.2.0",
    "description": "Authenticated project, manifest, capability, file, validation, history, runtime, event and AI discovery APIs. main.json is edited only through the manifest endpoint, which preserves its immutable id. Raw file writes remain blocked."
  },
  "security": [{ "developerToken": [] }],
  "paths": {
    "/dev/api/status": {
      "get": {
        "summary": "Read developer channel status",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "responses": { "200": { "description": "Status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeveloperStatus" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/dev/api/projects": {
      "get": {
        "summary": "List projects",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "responses": { "200": { "description": "Project list", "content": { "application/json": { "schema": { "type": "object", "required": ["requestId", "projects"], "properties": { "requestId": { "type": "string" }, "projects": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "summary": "Create a solo or multiplayer project from the managed template",
        "x-permission": "project.create",
        "x-risk": "medium",
        "x-idempotent": false,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectDraft" } } } },
        "responses": { "201": { "description": "Created project", "content": { "application/json": { "schema": { "type": "object", "required": ["requestId", "project"], "properties": { "requestId": { "type": "string" }, "project": { "$ref": "#/components/schemas/Project" } } } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/dev/api/capabilities": {
      "get": {
        "summary": "List the central capability registry with Chinese metadata and App/HTML adapter status",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "responses": { "200": { "description": "Capability registry", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityRegistryResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/dev/api/capability-tests": {
      "get": {
        "summary": "List registry-driven platform capability tests",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "responses": { "200": { "description": "Capability test catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityTestCatalog" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "summary": "Test all or selected platform capabilities",
        "x-permission": "capability.test",
        "x-risk": "low",
        "x-idempotent": false,
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityTestRequest" } } } },
        "responses": { "200": { "description": "Capability test results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityTestResponse" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/dev/api/ai-prompt-templates": {
      "get": {
        "summary": "List globally configured AI prompt templates grouped by category",
        "x-permission": "ai.prompt.read",
        "x-risk": "low",
        "x-idempotent": true,
        "responses": { "200": { "description": "Prompt template categories and items" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/dev/api/ai-prompt-templates/{templateId}": {
      "put": {
        "summary": "Save a global override for one AI prompt template",
        "x-permission": "ai.prompt.configure",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "name": "templateId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["content"], "properties": { "content": { "type": "string", "minLength": 1, "maxLength": 524288 } } } } } },
        "responses": { "200": { "description": "Saved template" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "delete": {
        "summary": "Remove one override and restore its bundled default",
        "x-permission": "ai.prompt.configure",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "name": "templateId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Reset template" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/dev/api/projects/{projectId}/files": {
      "get": {
        "summary": "List visible files and directories",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "description": "Tree entries", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileTree" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/dev/api/projects/{projectId}/manifest": {
      "get": {
        "summary": "Read main.json for visual editing",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "description": "Manifest and revision", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManifestDocument" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "put": {
        "summary": "Validate and update main.json while preserving its immutable id",
        "x-permission": "project.write",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManifestUpdate" } } } },
        "responses": { "200": { "description": "Updated manifest", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManifestDocument" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "409": { "$ref": "#/components/responses/RevisionConflict" } }
      }
    },
    "/dev/api/projects/{projectId}/capabilities": {
      "get": {
        "summary": "Read the optional capabilities.json declaration",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "description": "Capability declaration and revision", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityDocument" } } } } }
      },
      "put": {
        "summary": "Create, update, or remove capabilities.json from registry-backed codes",
        "x-permission": "project.write",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityUpdate" } } } },
        "responses": { "200": { "description": "Updated capability declaration", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityDocument" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "409": { "$ref": "#/components/responses/RevisionConflict" } }
      }
    },
    "/dev/api/projects/{projectId}/chat-prompt.txt": {
      "get": {
        "summary": "Export the game-specific pure-chat prompt as UTF-8 TXT",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": { "description": "Game-specific chat prompt", "content": { "text/plain": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/dev/api/projects/{projectId}/agent-prompt.txt": {
      "get": {
        "summary": "Export the game-specific Agent prompt with authenticated developer API details as UTF-8 TXT",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/AgentBaseUrl" }],
        "responses": {
          "200": { "description": "Game-specific Agent prompt", "content": { "text/plain": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/dev/api/projects/{projectId}/directory": {
      "post": {
        "summary": "Create a directory",
        "x-permission": "project.write",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientMutation" } } } },
        "responses": { "201": { "description": "Directory created" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "delete": {
        "summary": "Recursively delete a directory",
        "x-permission": "project.write",
        "x-risk": "high",
        "x-idempotent": false,
        "x-requires-confirmation": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientMutation" } } } },
        "responses": { "200": { "description": "Directory deleted" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/dev/api/projects/{projectId}/file-operations": {
      "post": {
        "summary": "Copy, move or extract an uploaded ZIP inside the project sandbox",
        "x-permission": "project.write",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileOperation" } } } },
        "responses": { "200": { "description": "Operation completed" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/dev/api/projects/{projectId}/file": {
      "get": {
        "summary": "Read a UTF-8 text file",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "responses": { "200": { "description": "Raw text; revision and read-only state are returned in X-Playmesh-Revision and X-Playmesh-Readonly headers", "content": { "text/plain": { "schema": { "type": "string" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "put": {
        "summary": "Create or replace a complete file",
        "x-permission": "project.write",
        "x-risk": "medium",
        "x-idempotent": false,
        "x-retry": "Repeat only after reading the current revision",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileWrite" } } } },
        "responses": { "200": { "description": "Saved file metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileMutationResult" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "409": { "$ref": "#/components/responses/RevisionConflict" } }
      },
      "patch": {
        "summary": "Apply ordered UTF-16 text offset operations",
        "x-permission": "project.write",
        "x-risk": "medium",
        "x-idempotent": false,
        "x-retry": "Re-read and rebuild operations after a revision conflict",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FilePatch" } } } },
        "responses": { "200": { "description": "Patched file metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileMutationResult" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "409": { "$ref": "#/components/responses/RevisionConflict" } }
      },
      "delete": {
        "summary": "Delete a file",
        "x-permission": "project.write",
        "x-risk": "high",
        "x-idempotent": false,
        "x-requires-confirmation": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileDelete" } } } },
        "responses": { "200": { "description": "File deleted" }, "409": { "$ref": "#/components/responses/RevisionConflict" } }
      }
    },
    "/dev/api/projects/{projectId}/asset": {
      "get": {
        "summary": "Read a text or binary project asset",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "responses": { "200": { "description": "Raw asset bytes with content type and revision headers" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/dev/api/projects/{projectId}/diff": {
      "get": {
        "summary": "Compare the current text file with its initial project source",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/Path" }],
        "responses": { "200": { "description": "File diff", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileDiff" } } } } }
      }
    },
    "/dev/api/projects/{projectId}/quick-operations/preview": {
      "post": {
        "summary": "Parse quick text operations and return before/after files plus base revisions; replace_file upserts and creates missing parent directories",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuickPreviewRequest" } } } },
        "responses": { "200": { "description": "Preview result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuickPreview" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/dev/api/projects/{projectId}/quick-operations/apply": {
      "post": {
        "summary": "Atomically apply a previously previewed quick operation batch",
        "x-permission": "project.write",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuickApplyRequest" } } } },
        "responses": { "200": { "description": "Batch applied" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "409": { "$ref": "#/components/responses/RevisionConflict" } }
      }
    },
    "/dev/api/projects/{projectId}/local-history": {
      "get": {
        "summary": "List project time operations for an optional scope",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/OptionalPath" }],
        "responses": { "200": { "description": "History operations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalHistoryList" } } } } }
      }
    },
    "/dev/api/projects/{projectId}/local-history/diff": {
      "get": {
        "summary": "Read structured before/after changes for a time operation",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/OperationId" }, { "$ref": "#/components/parameters/OptionalPath" }],
        "responses": { "200": { "description": "Structured local history diff" } }
      }
    },
    "/dev/api/projects/{projectId}/local-history/restore": {
      "post": {
        "summary": "Replace a file, directory or workspace with an operation before/after snapshot",
        "x-permission": "project.write",
        "x-risk": "high",
        "x-idempotent": false,
        "x-requires-confirmation": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalHistoryRestore" } } } },
        "responses": { "200": { "description": "Scope restored" }, "400": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/dev/api/projects/{projectId}/validate": {
      "get": {
        "summary": "Validate manifest, entries, publish files and local resource references",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "description": "Validation report", "content": { "application/json": { "schema": { "$ref": "/dev/schemas/project-validation.json" } } } } }
      }
    },
    "/dev/api/projects/{projectId}/run": {
      "get": {
        "summary": "Read current runtime status",
        "x-permission": "runtime.run",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "description": "Runtime status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStatus" } } } } }
      },
      "post": {
        "summary": "Validate and request the App to launch the project",
        "x-permission": "runtime.run",
        "x-risk": "medium",
        "x-idempotent": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "202": { "description": "Launch accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStatus" } } } }, "422": { "description": "package_validation_failed with validation report" } }
      }
    },
    "/dev/api/projects/{projectId}/data": {
      "delete": {
        "summary": "Delete only the current game's persisted SDK data directory and preserve cache",
        "x-permission": "project.data.clear",
        "x-risk": "high",
        "x-idempotent": true,
        "x-requires-confirmation": true,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": {
            "description": "Game data cleared; cache and project files preserved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projectId", "directory", "existed", "cachePreserved"],
                  "properties": {
                    "requestId": { "type": "string" },
                    "projectId": { "type": "string" },
                    "directory": { "const": "data" },
                    "existed": { "type": "boolean" },
                    "cachePreserved": { "const": true }
                  }
                }
              }
            }
          },
          "409": { "description": "game_running; exit the current game before clearing data" }
        }
      }
    },
    "/dev/api/projects/{projectId}/run/restart": {
      "post": {
        "summary": "Restart the currently running game instance without creating a new project",
        "x-permission": "runtime.run",
        "x-risk": "medium",
        "x-idempotent": false,
        "x-requires-confirmation": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "202": { "description": "Restart accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStatus" } } } },
          "404": { "description": "No running game instance is registered for this project" }
        }
      }
    },
    "/dev/api/projects/{projectId}/run/stop": {
      "post": {
        "summary": "Stop the currently running game instance and close its game session",
        "x-permission": "runtime.run",
        "x-risk": "medium",
        "x-idempotent": false,
        "x-requires-confirmation": false,
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": { "description": "Game stopped", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStatus" } } } },
          "404": { "description": "No running game instance is registered for this project" }
        }
      }
    },
    "/dev/api/events": {
      "get": {
        "summary": "Subscribe to project, file, validation, run and runtime.log events",
        "x-permission": "event.subscribe",
        "x-risk": "low",
        "x-idempotent": true,
        "responses": { "200": { "description": "text/event-stream; clients should reconnect automatically" } }
      }
    },
    "/dev/api/logs": {
      "get": {
        "summary": "Read recent runtime logs without subscribing to SSE",
        "x-permission": "log.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 50 } }],
        "responses": {
          "200": {
            "description": "Most recent logs in chronological order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["logs", "count", "maxLimit", "cachedEntries"],
                  "properties": {
                    "requestId": { "type": "string" },
                    "logs": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": true } },
                    "count": { "type": "integer", "minimum": 0, "maximum": 50 },
                    "maxLimit": { "const": 50 },
                    "cachedEntries": { "type": "integer", "minimum": 0, "maximum": 500 }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" }
        }
      }
    },
    "/dev/api/ai-context": {
      "get": {
        "summary": "Discover authentication, all interfaces, rules and schemas",
        "x-permission": "ai.context",
        "x-risk": "low",
        "x-idempotent": true,
        "responses": { "200": { "description": "AI context" } }
      }
    },
    "/dev/api/qr.svg": {
      "get": {
        "summary": "Render a QR code for a selected runtime link",
        "x-permission": "project.read",
        "x-risk": "low",
        "x-idempotent": true,
        "parameters": [{ "name": "value", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "SVG QR code", "content": { "image/svg+xml": { "schema": { "type": "string" } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "developerToken": { "type": "http", "scheme": "bearer", "description": "Persistent developer-workspace token stored with the configured port and workspace path. The token query parameter is also supported for EventSource and direct links." }
    },
    "parameters": {
      "ProjectId": { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
      "Path": { "name": "path", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Project-relative path; data/, cache/, .playmesh/ and path traversal are rejected" },
      "OptionalPath": { "name": "path", "in": "query", "required": false, "schema": { "type": "string", "default": "" } },
      "AgentBaseUrl": { "name": "baseUrl", "in": "query", "required": false, "schema": { "type": "string", "format": "uri" }, "description": "One of the current device HTTP addresses returned by GET /dev/api/status baseUrls; used for every Developer Gateway URL embedded in the Agent prompt" },
      "OperationId": { "name": "operationId", "in": "query", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "Unauthorized": { "description": "Developer token is missing, invalid or expired", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "InvalidRequest": { "description": "Invalid path, payload, encoding or operation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "NotFound": { "description": "Project, file, directory or operation not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "RevisionConflict": { "description": "baseRevision no longer matches", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionConflict" } } } }
    },
    "schemas": {
      "ErrorResponse": { "type": "object", "required": ["requestId", "error"], "properties": { "requestId": { "type": "string" }, "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } },
      "RevisionConflict": { "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }], "properties": { "error": { "properties": { "currentRevision": { "type": "integer", "minimum": 0 } } } } },
      "DeveloperStatus": { "type": "object", "required": ["requestId", "enabled", "port", "baseUrls", "tokenHint"], "properties": { "requestId": { "type": "string" }, "enabled": { "type": "boolean" }, "port": { "type": "integer" }, "baseUrls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } }, "tokenHint": { "type": "string" }, "createdAt": { "type": ["integer", "null"] } } },
      "Project": { "type": "object", "required": ["id", "name", "version", "readOnly", "manifestReadOnly", "manifestIdReadOnly"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "string" }, "readOnly": { "type": "boolean" }, "manifestReadOnly": { "const": false }, "manifestIdReadOnly": { "const": true } } },
      "CapabilityDefinition": { "type": "object", "additionalProperties": false, "required": ["code", "name", "description", "appSupported", "htmlSupported"], "properties": { "code": { "type": "string" }, "name": { "type": "string", "description": "Chinese display name" }, "description": { "type": "string" }, "appSupported": { "type": "boolean" }, "htmlSupported": { "type": "boolean" } } },
      "CapabilityRegistryResponse": { "type": "object", "additionalProperties": false, "required": ["requestId", "capabilities"], "properties": { "requestId": { "type": "string" }, "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/CapabilityDefinition" } } } },
      "CapabilityTestDefinition": { "allOf": [{ "$ref": "#/components/schemas/CapabilityDefinition" }, { "type": "object", "required": ["testable", "platformAvailable"], "properties": { "testable": { "type": "boolean" }, "platformAvailable": { "type": "boolean" } } }] },
      "CapabilityTestCatalog": { "type": "object", "required": ["requestId", "capabilities"], "properties": { "requestId": { "type": "string" }, "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/CapabilityTestDefinition" } } } },
      "CapabilityTestRequest": { "type": "object", "properties": { "codes": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Omit or pass an empty array to test every registered capability" }, "timeoutMs": { "type": "integer", "minimum": 250, "maximum": 10000, "default": 3000 } } },
      "CapabilityTestResult": { "type": "object", "required": ["code", "name", "status", "message", "durationMs"], "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "status": { "enum": ["passed", "unavailable", "timeout", "failed", "not_testable"] }, "message": { "type": "string" }, "durationMs": { "type": "integer" }, "sample": { "type": "object", "additionalProperties": true } } },
      "CapabilityTestResponse": { "type": "object", "required": ["requestId", "testedAt", "results", "passed", "total"], "properties": { "requestId": { "type": "string" }, "testedAt": { "type": "integer" }, "results": { "type": "array", "items": { "$ref": "#/components/schemas/CapabilityTestResult" } }, "passed": { "type": "integer" }, "total": { "type": "integer" } } },
      "ManifestDocument": { "type": "object", "required": ["requestId", "projectId", "revision", "manifest"], "properties": { "requestId": { "type": "string" }, "projectId": { "type": "string" }, "revision": { "type": "integer", "minimum": 0 }, "manifest": { "type": "object", "description": "Validated main.json; id always equals projectId" } } },
      "ManifestUpdate": { "type": "object", "required": ["manifest", "baseRevision"], "properties": { "manifest": { "type": "object", "description": "Complete main.json; id cannot change" }, "baseRevision": { "type": "integer", "minimum": 0 }, "clientId": { "type": "string" } } },
      "CapabilityDocument": { "type": "object", "additionalProperties": false, "required": ["requestId", "projectId", "exists", "revision", "required"], "properties": { "requestId": { "type": "string" }, "projectId": { "type": "string" }, "exists": { "type": "boolean" }, "revision": { "type": "integer", "minimum": 0 }, "required": { "type": "array", "uniqueItems": true, "items": { "type": "string", "description": "Must exist in the central capability registry" } } } },
      "CapabilityUpdate": { "type": "object", "required": ["required", "baseRevision"], "properties": { "required": { "type": "array", "uniqueItems": true, "items": { "type": "string", "description": "Must exist in GET /dev/api/capabilities; an empty list removes capabilities.json" } }, "baseRevision": { "type": "integer", "minimum": 0 }, "clientId": { "type": "string" } } },
      "ProjectDraft": { "type": "object", "required": ["id", "name", "mode", "orientation", "displayMode", "minPlayers", "maxPlayers"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 }, "tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }, "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "description": "Must exist in GET /dev/api/capabilities" } }, "mode": { "enum": ["solo", "multiplayer"] }, "orientation": { "enum": ["landscape", "portrait"] }, "displayMode": { "enum": ["multi_screen", "single_screen_multiplayer"] }, "minPlayers": { "type": "integer", "minimum": 1 }, "maxPlayers": { "type": "integer", "minimum": 1 }, "clientId": { "type": "string" } }, "description": "solo requires multi_screen and minPlayers=maxPlayers=1; tags and requiredCapabilities are written during creation" },
      "ClientMutation": { "type": "object", "properties": { "clientId": { "type": "string" } } },
      "FileTree": { "type": "object", "required": ["requestId", "projectId", "files", "directories"], "properties": { "requestId": { "type": "string" }, "projectId": { "type": "string" }, "files": { "type": "array", "items": { "type": "string" } }, "directories": { "type": "array", "items": { "type": "string" } } } },
      "FileWrite": { "type": "object", "required": ["content", "baseRevision"], "properties": { "content": { "type": "string" }, "encoding": { "enum": ["utf8", "base64"], "default": "utf8" }, "baseRevision": { "type": "integer", "minimum": 0 }, "clientId": { "type": "string" } } },
      "TextOperation": { "type": "object", "required": ["start", "end", "text"], "properties": { "start": { "type": "integer", "minimum": 0, "description": "UTF-16 code-unit start offset" }, "end": { "type": "integer", "minimum": 0, "description": "UTF-16 code-unit end offset, exclusive" }, "text": { "type": "string" } } },
      "FilePatch": { "type": "object", "required": ["baseRevision", "operations"], "properties": { "baseRevision": { "type": "integer", "minimum": 0 }, "clientId": { "type": "string" }, "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/TextOperation" } } } },
      "FileDelete": { "type": "object", "required": ["baseRevision"], "properties": { "baseRevision": { "type": "integer", "minimum": 0 }, "clientId": { "type": "string" } } },
      "FileOperation": { "type": "object", "required": ["operation", "source", "destination"], "properties": { "operation": { "enum": ["copy", "move", "extract"] }, "source": { "type": "string" }, "destination": { "type": "string", "description": "Target path for copy/move; target directory (or empty root) for extract" }, "clientId": { "type": "string" } } },
      "FileMutationResult": { "type": "object", "required": ["requestId", "projectId", "file"], "properties": { "requestId": { "type": "string" }, "projectId": { "type": "string" }, "file": { "type": "object", "required": ["path", "readOnly", "revision", "contentType"], "properties": { "path": { "type": "string" }, "readOnly": { "type": "boolean" }, "revision": { "type": "integer" }, "contentType": { "type": "string" } } } } },
      "FileDiff": { "type": "object", "required": ["path", "changed", "original", "current"], "properties": { "path": { "type": "string" }, "changed": { "type": "boolean" }, "original": { "type": "string" }, "current": { "type": "string" } } },
      "QuickPreviewRequest": { "type": "object", "required": ["commands"], "properties": { "commands": { "type": "string" } } },
      "QuickApplyRequest": { "type": "object", "required": ["commands", "baseRevisions"], "properties": { "commands": { "type": "string" }, "baseRevisions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }, "clientId": { "type": "string" } } },
      "QuickPreview": { "type": "object", "required": ["requestId", "files", "baseRevisions"], "properties": { "requestId": { "type": "string" }, "files": { "type": "array", "items": { "type": "object", "required": ["path", "original", "current", "changed", "created", "revision"] } }, "baseRevisions": { "type": "object", "additionalProperties": { "type": "integer" } } } },
      "LocalHistoryList": { "type": "object", "required": ["requestId", "projectId", "path", "mergeWindowSeconds", "operations"], "properties": { "requestId": { "type": "string" }, "projectId": { "type": "string" }, "path": { "type": "string" }, "mergeWindowSeconds": { "const": 300 }, "operations": { "type": "array", "items": { "type": "object", "required": ["id", "summary", "createdAt", "updatedAt", "changeCount"] } } } },
      "LocalHistoryRestore": { "type": "object", "required": ["operationId", "path", "version"], "properties": { "operationId": { "type": "string" }, "path": { "type": "string", "description": "Empty string restores the workspace while preserving main.json" }, "version": { "enum": ["before", "after"] }, "clientId": { "type": "string" } } },
      "RunStatus": { "type": "object", "required": ["projectId", "phase", "message", "links"], "properties": { "projectId": { "type": "string" }, "phase": { "enum": ["idle", "starting", "running", "stopped", "error"] }, "message": { "type": "string" }, "joinCode": { "type": ["string", "null"] }, "links": { "type": "array", "items": { "type": "string", "format": "uri" } } } }
    }
  }
}
