{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playmesh.local/schemas/sdk-v1.json",
  "title": "Playmesh Game SDK v1 Types",
  "$defs": {
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nickname",
        "role",
        "connected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "role": {
          "enum": [
            "authority",
            "authority_player",
            "player"
          ]
        },
        "connected": {
          "type": "boolean"
        }
      }
    },
    "AppIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "nickname",
        "source"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^u_"
        },
        "nickname": {
          "type": "string"
        },
        "source": {
          "const": "playmesh_app"
        }
      }
    },
    "CapabilityDefinition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "name",
        "description",
        "apiVersion",
        "methods",
        "events"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "apiVersion": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "SessionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "joinCode",
        "gameId",
        "displayMode",
        "state",
        "minPlayers",
        "maxPlayers",
        "authorityClientId",
        "players"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "joinCode": {
          "type": "string"
        },
        "gameId": {
          "type": "string"
        },
        "displayMode": {
          "enum": [
            "multi_screen",
            "single_screen_multiplayer"
          ]
        },
        "state": {
          "enum": [
            "lobby",
            "running",
            "paused",
            "stopped"
          ]
        },
        "minPlayers": {
          "type": "integer",
          "minimum": 1
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 1
        },
        "authorityClientId": {
          "type": "string",
          "description": "Identity assigned to the App runtime that created and runs the session; never elected from player order"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Player"
          },
          "description": "Participating players only; array position and join order have no Authority meaning"
        }
      }
    },
    "PlayerConnectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player",
        "session",
        "isCurrentPlayer"
      ],
      "properties": {
        "player": {
          "$ref": "#/$defs/Player"
        },
        "session": {
          "$ref": "#/$defs/SessionSnapshot"
        },
        "isCurrentPlayer": {
          "type": "boolean"
        }
      }
    },
    "AuthorityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "senderPlayerId",
        "session",
        "members"
      ],
      "properties": {
        "senderPlayerId": {
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionSnapshot"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Player"
          }
        }
      }
    },
    "AuthorityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetPlayerIds",
        "message"
      ],
      "properties": {
        "targetPlayerIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "message": {
          "type": "object"
        }
      }
    },
    "LifecycleEvent": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ready",
            "pause",
            "resume",
            "exit",
            "closed",
            "error"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SyncSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "stateType",
        "full",
        "revision",
        "sequence",
        "timestamp",
        "sourceTick",
        "state"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "stateType": {
          "type": "string"
        },
        "full": {
          "const": true
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "sourceTick": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/JsonValue"
        }
      }
    },
    "LatencyDiagnostics": {
      "type": "object",
      "required": [
        "clientSentAt",
        "receivedAt",
        "authorityAvailable"
      ],
      "properties": {
        "probeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientSentAt": {
          "type": "integer"
        },
        "serverReceivedAt": {
          "type": [
            "integer",
            "null"
          ]
        },
        "serverSentAt": {
          "type": [
            "integer",
            "null"
          ]
        },
        "receivedAt": {
          "type": "integer"
        },
        "authorityAvailable": {
          "type": "boolean"
        },
        "rawRttMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "BinaryChannelMode": {
      "enum": [
        "authority",
        "relay"
      ]
    },
    "BinaryDelivery": {
      "enum": [
        "queued",
        "latest"
      ]
    },
    "BinaryMessageContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "senderPlayerId",
        "delivery"
      ],
      "properties": {
        "senderPlayerId": {
          "type": "string",
          "description": "Uses the stable value authority when the sender is the Authority runtime"
        },
        "delivery": {
          "$ref": "#/$defs/BinaryDelivery"
        }
      }
    },
    "BinaryForwardContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "senderPlayerId",
        "targetPlayerIds",
        "delivery"
      ],
      "properties": {
        "senderPlayerId": {
          "type": "string"
        },
        "targetPlayerIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Normalized recipients for this one review; Authority uses the stable value authority"
        },
        "delivery": {
          "$ref": "#/$defs/BinaryDelivery"
        }
      }
    },
    "BucketUploadUrl": {
      "type": "string",
      "pattern": "^/bucket/[A-Za-z0-9][A-Za-z0-9_-]{0,63}/[0-9]+(?:\\.[A-Za-z0-9]{1,16})?$",
      "description": "Same-origin URL returned by StorageBucket.upload(file)"
    },
    "SdkBootstrap": {
      "type": "object",
      "required": [
        "sdkVersion",
        "isAuthority",
        "player",
        "session"
      ],
      "properties": {
        "sdkVersion": {
          "const": "2.2.2"
        },
        "isAuthority": {
          "type": "boolean"
        },
        "player": {
          "oneOf": [
            {
              "$ref": "#/$defs/Player"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "oneOf": [
            {
              "$ref": "#/$defs/SessionSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
