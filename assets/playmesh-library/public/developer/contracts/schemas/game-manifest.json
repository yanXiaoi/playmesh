{
  "$id": "game-manifest.json",
  "title": "Playmesh main.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "sdkVersion",
    "appSdkVersion",
    "orientation",
    "modes",
    "displayModes",
    "players",
    "entries"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "maxLength": 80,
      "readOnly": true,
      "description": "Platform-managed upload metadata; a missing value remains an empty dynamic publisher value for the App shell to present."
    },
    "lastModifiedAt": {
      "type": "integer",
      "minimum": 0,
      "readOnly": true,
      "description": "Optional Unix epoch milliseconds; presentation of a missing value belongs to the localized App shell."
    },
    "remarks": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "sdkVersion": {
      "type": "string",
      "const": "4.1.0"
    },
    "appSdkVersion": {
      "type": "string",
      "enum": [
        "3.2.0",
        "3.3.0"
      ]
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait"
      ]
    },
    "controllerOrientation": {
      "enum": [
        "landscape",
        "portrait"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "solo",
          "multiplayer"
        ]
      }
    },
    "displayModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "multi_screen",
          "single_screen_multiplayer"
        ]
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game"
      ],
      "properties": {
        "game": {
          "$ref": "#/$defs/htmlEntry"
        },
        "controller": {
          "$ref": "#/$defs/htmlEntry"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/javascriptEntry"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "modes": {
            "contains": {
              "const": "multiplayer"
            }
          }
        },
        "required": [
          "modes"
        ]
      },
      "then": {
        "required": [
          "authority"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "displayModes": {
            "contains": {
              "const": "single_screen_multiplayer"
            }
          }
        },
        "required": [
          "displayModes"
        ]
      },
      "then": {
        "required": [
          "controllerOrientation"
        ],
        "properties": {
          "entries": {
            "required": [
              "controller"
            ]
          }
        },
        "description": "single_screen_multiplayer requires explicit controllerOrientation and entries.controller declarations"
      },
      "else": {
        "not": {
          "required": [
            "controllerOrientation"
          ]
        }
      }
    }
  ],
  "$defs": {
    "packagePath": {
      "type": "string",
      "pattern": "^(?:[^/]+/)*[^/]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[Pp][Ll][Aa][Yy][Mm][Ee][Ss][Hh]|[Bb][Uu][Cc][Kk][Ee][Tt])(?:/|$)"
          },
          {
            "pattern": "(^|/)\\.{1,2}(/|$)|[\\\\%?#]"
          },
          {
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
          }
        ]
      }
    },
    "htmlEntry": {
      "type": "string",
      "description": "Unencoded relative HTML path with an optional query string. Parameter-segment order, duplicate keys, and encoded-value semantics are preserved; a runtime URI may normalize percent-escape hex digits to uppercase. Fragments and external URLs are forbidden.",
      "allOf": [
        {
          "pattern": "^(?:[^/?#]+/)*[^/?#]+\\.[Hh][Tt][Mm][Ll](?:\\?(?:%[0-9A-Fa-f]{2}|[^%\\s#])+)?$"
        },
        {
          "not": {
            "anyOf": [
              {
                "pattern": "^(?:[Pp][Ll][Aa][Yy][Mm][Ee][Ss][Hh]|[Bb][Uu][Cc][Kk][Ee][Tt])(?:/|$)"
              },
              {
                "pattern": "(^|/)\\.{1,2}(?:/|\\?|$)|[\\\\#]|^[^?]*%"
              },
              {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
              }
            ]
          }
        }
      ]
    },
    "javascriptEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/packagePath"
        },
        {
          "pattern": "\\.(?:[Jj][Ss]|[Mm][Jj][Ss])$"
        }
      ]
    }
  }
}
