{
  "manifestVersion": "1.0.0",
  "defaultLocale": "zh-CN",
  "ui": {
    "allowLocaleSwitch": true,
    "defaultThemeMode": "system",
    "allowThemeSwitch": true
  },
  "locales": [
    {
      "id": "zh-CN",
      "label": "简体中文",
      "enabled": true,
      "fallback": null,
      "bundles": {
        "goServer": "zh-CN.json"
      }
    },
    {
      "id": "en-US",
      "label": "English (United States)",
      "enabled": true,
      "fallback": "zh-CN",
      "bundles": {
        "goServer": "en-US.json"
      }
    }
  ]
}
