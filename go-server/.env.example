# 管理后台登录账号。必填、无安全默认值；仅用于独立管理端口，不会显示在公开页面。
PLAYMESH_ADMIN_USERNAME=admin
# 管理后台登录密码。必填；支持明文或 bcrypt 哈希，生产环境建议使用密码生成器创建长随机值。
PLAYMESH_ADMIN_PASSWORD=replace-with-a-long-random-password
# 管理页面的私密 URL 路径。必填；必须以 / 开头，只能包含字母、数字、-、_ 和路径分隔符，
# 不能使用 /、/api、/assets、/health 等保留路径，也不能以 / 结尾；建议使用不可预测的随机路径。
PLAYMESH_ADMIN_PATH=/manage-replace-with-a-long-random-path

# 正式发布游戏源的访问 Token。必填；客户端读取正式目录及相关受保护接口时使用，
# 必须与 PLAYMESH_REVIEW_TOKEN 不同，并应使用足够长的随机值。
PLAYMESH_PUBLISHED_TOKEN=987654321
# 待审核/管理兼容访问 Token。必填；用于审核链路和 Relay 兼容鉴权，不进入正式 Catalog 展示，
# 必须与 PLAYMESH_PUBLISHED_TOKEN 不同。
PLAYMESH_REVIEW_TOKEN=123456789
# 用户上传密钥的 HMAC Pepper。必填且至少 32 字节；仅服务端保存。
# 修改后，所有已有上传密钥摘要都将无法继续验证，因此轮换前必须安排密钥重发。
PLAYMESH_UPLOAD_KEY_PEPPER=replace-with-at-least-32-random-bytes

# 是否启用 ClamAV 扫描。布尔值 true/false，默认 true。
# 设为 false 只关闭病毒扫描；ZIP 路径、大小、压缩比和内容正则规则仍会执行。
PLAYMESH_CLAMAV_ENABLED=false
# clamscan 可执行文件路径。默认 clamscan；只能指向 clamscan 或 clamscan.exe，
# Windows 可填写绝对路径。安装说明：https://docs.clamav.net/manual/Installing.html
PLAYMESH_CLAMSCAN_PATH=clamscan

# 是否启用 SMTP 邮件。布尔值 true/false，默认 false。
# 邮箱验证开启时必须设为 true；关闭时审核结果仍会完整保存在 SQLite。
PLAYMESH_SMTP_ENABLED=false
# SMTP 服务器主机名或 IP。启用 SMTP 时必填，不包含协议和端口，例如 smtp.example.com。
PLAYMESH_SMTP_HOST=smtp.example.com
# SMTP 服务器端口。整数 1-65535，默认 587；隐式 TLS 常用 465，明文 SMTP 常用 25/587。
PLAYMESH_SMTP_PORT=587
# SMTP 登录账号。服务器允许匿名投递时可留空；填写后会使用 SMTP PLAIN 认证。
PLAYMESH_SMTP_USERNAME=
# SMTP 登录密码。仅在填写账号并需要认证时使用；请勿提交真实值到版本库。
PLAYMESH_SMTP_PASSWORD=
# 发件人地址。启用 SMTP 时必填，必须是合法邮箱地址；可使用“显示名 <邮箱>”格式。
PLAYMESH_SMTP_FROM=Playmesh Review <noreply@example.com>
# 是否从连接开始即使用 TLS。布尔值 true/false，默认 false；这是隐式 TLS，不是 STARTTLS。
# 使用 465 等隐式 TLS 端口时设为 true；服务器要求明文连接时保持 false。
PLAYMESH_SMTP_TLS=false
# 审核失败/拒绝时是否发送结果邮件。布尔值 true/false，默认 true；仅在 SMTP 启用时生效。
PLAYMESH_SMTP_SEND_REVIEW_FAILURES=true
